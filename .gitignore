cat > .gitignore <<'EOF'
# =========================================================
# DEPENDENCIES
# =========================================================

# Node.js dependencies - frontend
/frontend/node_modules/

# Node.js dependencies - backend
/backend/node_modules/

# Qualquer node_modules eventualmente criado em subdiretórios
**/node_modules/


# =========================================================
# NEXT.JS / FRONTEND
# =========================================================

/frontend/.next/
/frontend/out/

# Next.js cache
**/.next/
**/out/


# =========================================================
# ENVIRONMENT VARIABLES
# =========================================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Permite versionar arquivos de exemplo
!.env.example


# =========================================================
# LOGS
# =========================================================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# =========================================================
# BUILD / CACHE
# =========================================================

dist/
build/
coverage/
.cache/
.parcel-cache/


# =========================================================
# OS / EDITOR
# =========================================================

.DS_Store
Thumbs.db

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/


# =========================================================
# TEMPORARY FILES
# =========================================================

*.tmp
*.temp
*.swp
*.swo
EOF