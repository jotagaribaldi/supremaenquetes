generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model responses {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId            String?   @db.Uuid @map("survey_id")
  city                String    @db.VarChar(255)
  gender              String    @db.VarChar(50)
  ageRange            String    @db.VarChar(50) @map("age_range")
  education           String    @db.VarChar(50)
  tocantinsVote       String    @db.VarChar(3) @map("tocantins_vote")
  governorVote        String?   @db.VarChar(255) @map("governor_vote")
  governorRejection   String?   @db.VarChar(255) @map("governor_rejection")
  presidentVote       String?   @db.VarChar(255) @map("president_vote")
  presidentRejection  String?   @db.VarChar(255) @map("president_rejection")
  senatorVote         String?   @db.VarChar(255) @map("senator_vote")
  senatorVote2        String?   @db.VarChar(255) @map("senator_vote2")
  stateDeputyVote              String?   @db.VarChar(255) @map("state_deputy_vote")
  stateDeputyReelectionRejection String? @db.VarChar(255) @map("state_deputy_reelection_rejection")
  presidentEvaluation            String?  @db.VarChar(20) @map("president_evaluation")
  governorEvaluation             String?  @db.VarChar(20) @map("governor_evaluation")
  federalDeputyVote              String?  @db.VarChar(255) @map("federal_deputy_vote")
  ipAddress           String    @db.Inet @map("ip_address")
  latitude            Decimal   @db.Decimal(10, 8)
  longitude           Decimal   @db.Decimal(11, 8)
  createdAt           DateTime? @default(now()) @db.Timestamp(6) @map("created_at")
  isValid             Boolean?  @default(true) @map("is_valid")
  surveys             surveys?  @relation(fields: [surveyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt], map: "idx_responses_created_at")
  @@index([ipAddress], map: "idx_responses_ip")
  @@index([surveyId], map: "idx_responses_survey_id")
}

model surveys {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String      @db.VarChar(255)
  tenantId   String?     @db.Uuid @map("tenant_id")
  state      String?     @db.VarChar(2) @map("state")
  createdAt  DateTime?   @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt  DateTime?   @default(now()) @db.Timestamp(6) @map("updated_at")
  responses  responses[]
  tenants    tenants?    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId], map: "idx_surveys_tenant_id")
}

model tenants {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(255)
  plan       String?   @default("free") @db.VarChar(50)
  createdAt  DateTime? @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt  DateTime? @default(now()) @db.Timestamp(6) @map("updated_at")
  surveys    surveys[]
  users      users[]
}

model users {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       String    @default("client") @db.VarChar(50)
  tenantId   String?   @db.Uuid @map("tenant_id")
  createdAt  DateTime? @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt  DateTime? @default(now()) @db.Timestamp(6) @map("updated_at")
  tenants    tenants?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId], map: "idx_users_tenant_id")
}

model candidates {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state           String    @db.VarChar(2) @map("state")
  cargoCode       Int       @map("cargo_code")
  cargoName       String    @db.VarChar(50) @map("cargo_name")
  candidateNumber Int       @map("candidate_number")
  name            String    @db.VarChar(255)
  urnName         String    @db.VarChar(255) @map("urn_name")
  partyNumber     Int?      @map("party_number")
  partyAcronym    String?   @db.VarChar(20) @map("party_acronym")
  partyName       String?   @db.VarChar(255) @map("party_name")
  coalitionName   String?   @db.VarChar(255) @map("coalition_name")
  federationName  String?   @db.VarChar(255) @map("federation_name")
  situation       String?   @db.VarChar(50)
  email           String?   @db.VarChar(500)
  reelection      Boolean   @default(false) @map("reelection")
  createdAt       DateTime? @default(now()) @db.Timestamp(6) @map("created_at")

  @@index([state], map: "idx_candidates_state")
  @@index([cargoCode], map: "idx_candidates_cargo_code")
  @@index([state, cargoCode], map: "idx_candidates_state_cargo")
}
